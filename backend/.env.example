SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
FRONTEND_URL=http://127.0.0.1:5173
SESSION_COOKIE_NAME=session_id
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- ingestion scripts only (backend/ingestion/), not used by the web app ---
# Obtain by running: python -m ingestion.get_refresh_token
SPOTIFY_REFRESH_TOKEN=
BQ_PROJECT_ID=spotify-trend-dashboard
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcloud/keys/spotify-trend-dashboard-dbt-ingest.json
